<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.kovospace</groupId>
    <artifactId>new-tab-links-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>new-tab-links-backend</name>
    <description>Backend service for the NewTabLinks Chrome extension</description>

    <properties>
        <java.version>25</java.version>

        <springdoc.version>3.1.0</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>

        <!--
          Version of the database schema this application expects.

          Flyway migrations live in their own repository and are shipped as a Docker
          image that runs as a Kubernetes init container before this app starts. This
          property is the contract between the two: it names the migration image tag
          that produces the schema this build was written against.

          It is baked into the build info (see spring-boot-maven-plugin below), so the
          running application can report the schema it needs via /actuator/info, and
          the deployment can pin the init container to the very same tag.

          Bump it in the same commit that starts depending on a new migration.
        -->
        <flyway.migrations.schema.version>0.0.1</flyway.migrations.schema.version>
    </properties>

    <dependencies>
        <!-- ===== web / api ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- OpenAPI 3 documentation and the Swagger UI, served by the application. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== persistence ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== operations ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== mapping ===== -->
        <!-- Entity <-> DTO mapping. Implementations are generated at compile time
             by the annotation processor configured on maven-compiler-plugin below. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ===== test ===== -->
        <!-- Spring Boot 4 splits the old spring-boot-starter-test into one test
             starter per slice; each one below pairs with a starter above. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <!-- MapStruct options are scoped to the main compile on purpose. The
                             test sources contain no @Mapper, so its processor does not claim
                             these options there and javac warns that nothing recognised them. -->
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <!-- Fail the build on an unmapped target property instead of
                                     silently generating a mapper that leaves fields null. -->
                                <compilerArg>-Amapstruct.unmappedTargetPolicy=ERROR</compilerArg>
                                <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Writes META-INF/build-info.properties, which actuator exposes
                             at /actuator/info. The extra entry publishes the schema version
                             this build needs, so a deployed pod can be checked against the
                             migration image that actually ran. -->
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <flywayMigrationsSchemaVersion>${flyway.migrations.schema.version}</flywayMigrationsSchemaVersion>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
